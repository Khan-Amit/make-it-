# Compiled binaries (if any)
*.exe
*.out
*.o

# Python cache (if you ever add Python scripts)
__pycache__/
*.pyc

# Local notes saved by the tool (browser localStorage is not a file – but if you export notes)
notes_export.txt
*.bak

# OS garbage
.DS_Store
Thumbs.db
desktop.ini

# Editor temp files
*.swp
*~
*.tmp

# Logs
*.log

# Your local copy of the HTML (if you keep a backup)
software_writer_backup.html
make-it_backup.html
