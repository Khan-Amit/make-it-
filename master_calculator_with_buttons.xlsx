import pandas as pd
import openpyxl
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.drawing.image import Image
from datetime import datetime
import os
import webbrowser

class MasterExcelWithButtons:
    def __init__(self, filename="master_calculator_with_buttons.xlsx"):
        self.filename = filename
        
    def create_master_system(self):
        """Create Excel system with clickable dashboard buttons"""
        
        # ========== DASHBOARD with BUTTON DESCRIPTIONS ==========
        dashboard_data = {
            '🔘 BUTTON': ['STOCK CALCULATOR', 'DEMOGRAPHY', 'STATISTICS', 'FINANCE', 
                         'MATH CALCULATOR', 'GEOMETRY', 'PERCENTAGE', 'TREND ANALYSIS', 
                         'UNIT CONVERTER', 'ADD NEW CALCULATION'],
            '📋 DESCRIPTION': ['Calculate inventory value & profit', 'Population & demographic stats',
                             'Mean, median, sum analysis', 'Budget & running balance',
                             'Add, subtract, multiply, divide', 'Area & volume of shapes',
                             'Discount, tax, margin calculator', 'Sales growth & trends',
                             'Convert between units', 'Create your own custom calculator'],
            '🎯 ACTION': ['Click STOCK tab below', 'Click DEMOGRAPHY tab', 'Click STATISTICS tab', 
                         'Click FINANCE tab', 'Click MATH tab', 'Click GEOMETRY tab',
                         'Click PERCENTAGE tab', 'Click TREND tab', 'Click UNIT tab',
                         'Right-click → Copy Sheet'],
            '📊 STATUS': ['✅ ACTIVE', '✅ ACTIVE', '✅ ACTIVE', '✅ ACTIVE', 
                         '✅ ACTIVE', '✅ ACTIVE', '✅ ACTIVE', '✅ ACTIVE', 
                         '✅ ACTIVE', '✨ READY'],
            '📈 QUICK VIEW': ['$0', '0 People', '0 Data Points', '$0 Balance', 
                            '0 Operations', '0 Shapes', '0%', '0% Growth', 
                            '0 Conversions', 'Unlimited']
        }
        df_dashboard = pd.DataFrame(dashboard_data)
        
        # ========== STOCK CALCULATOR ==========
        stock_data = {
            'Product': ['Gold', 'Silver', 'Platinum', 'Diamond', 'Ruby', 'Emerald', 'Sapphire'],
            'Quantity': [100, 500, 50, 25, 40, 30, 45],
            'Unit Price ($)': [85000, 950, 30000, 15000, 5000, 8000, 6000],
            'Total Value ($)': [0, 0, 0, 0, 0, 0, 0],
            'Cost Price ($)': [75000, 800, 25000, 12000, 4000, 6500, 4800],
            'Profit ($)': [0, 0, 0, 0, 0, 0, 0],
            'Profit Margin %': [0, 0, 0, 0, 0, 0, 0]
        }
        df_stock = pd.DataFrame(stock_data)
        df_stock['Total Value ($)'] = df_stock['Quantity'] * df_stock['Unit Price ($)']
        df_stock['Profit ($)'] = df_stock['Total Value ($)'] - (df_stock['Quantity'] * df_stock['Cost Price ($)'])
        df_stock['Profit Margin %'] = (df_stock['Profit ($)'] / (df_stock['Quantity'] * df_stock['Cost Price ($)'])) * 100
        df_stock['Profit Margin %'] = df_stock['Profit Margin %'].round(2)
        
        # ========== DEMOGRAPHY ==========
        demography_data = {
            'Age Group': ['0-18', '19-30', '31-45', '46-60', '60+', 'TOTAL'],
            'Population': [25000, 45000, 38000, 22000, 15000, 145000],
            'Male %': [48, 50, 49, 47, 42, 0],
            'Female %': [52, 50, 51, 53, 58, 0],
            'Male Count': [0, 0, 0, 0, 0, 0],
            'Female Count': [0, 0, 0, 0, 0, 0],
            'Growth Rate %': [2.1, 1.8, 1.2, 0.5, -0.2, 0]
        }
        df_demography = pd.DataFrame(demography_data)
        for i in range(len(df_demography) - 1):
            df_demography.at[i, 'Male Count'] = int(df_demography.at[i, 'Population'] * df_demography.at[i, 'Male %'] / 100)
            df_demography.at[i, 'Female Count'] = int(df_demography.at[i, 'Population'] * df_demography.at[i, 'Female %'] / 100)
        df_demography.at[5, 'Male Count'] = df_demography['Male Count'].sum()
        df_demography.at[5, 'Female Count'] = df_demography['Female Count'].sum()
        
        # ========== STATISTICS ==========
        statistics_data = {
            'Dataset': ['Sample 1', 'Sample 2', 'Sample 3', 'Sample 4', 'Sample 5', 'STATISTICS'],
            'Value 1': [23, 45, 67, 12, 89, 0],
            'Value 2': [34, 56, 78, 23, 45, 0],
            'Value 3': [45, 67, 89, 34, 56, 0],
            'Mean': [0, 0, 0, 0, 0, 0],
            'Median': [0, 0, 0, 0, 0, 0],
            'Sum': [0, 0, 0, 0, 0, 0]
        }
        df_stats = pd.DataFrame(statistics_data)
        for i in range(5):
            values = [df_stats.at[i, 'Value 1'], df_stats.at[i, 'Value 2'], df_stats.at[i, 'Value 3']]
            df_stats.at[i, 'Mean'] = round(sum(values) / len(values), 2)
            df_stats.at[i, 'Median'] = sorted(values)[1]
            df_stats.at[i, 'Sum'] = sum(values)
        
        # ========== FINANCE ==========
        finance_data = {
            'Date': ['2026-05-01', '2026-05-02', '2026-05-03', '2026-05-04', '2026-05-05', '2026-05-06', '2026-05-07'],
            'Description': ['Salary', 'Rent', 'Groceries', 'Investment', 'Shopping', 'Savings', 'Entertainment'],
            'Income ($)': [5000, 0, 0, 0, 0, 0, 0],
            'Expense ($)': [0, 1200, 500, 1000, 300, 500, 200],
            'Balance ($)': [0, 0, 0, 0, 0, 0, 0]
        }
        df_finance = pd.DataFrame(finance_data)
        balance = 0
        for i in range(len(df_finance)):
            balance += df_finance.at[i, 'Income ($)'] - df_finance.at[i, 'Expense ($)']
            df_finance.at[i, 'Balance ($)'] = balance
        
        # ========== MATH CALCULATOR ==========
        math_data = {
            'Operation': ['Addition', 'Subtraction', 'Multiplication', 'Division', 'Power', 'Square Root', 'Percentage'],
            'Number A': [15, 50, 12, 100, 5, 64, 200],
            'Number B': [10, 25, 8, 20, 2, 2, 15],
            'Result': [0, 0, 0, 0, 0, 0, 0],
            'Formula': ['A + B', 'A - B', 'A × B', 'A ÷ B', 'A^B', '√A', '(A × B)/100']
        }
        df_math = pd.DataFrame(math_data)
        df_math.at[0, 'Result'] = df_math.at[0, 'Number A'] + df_math.at[0, 'Number B']
        df_math.at[1, 'Result'] = df_math.at[1, 'Number A'] - df_math.at[1, 'Number B']
        df_math.at[2, 'Result'] = df_math.at[2, 'Number A'] * df_math.at[2, 'Number B']
        df_math.at[3, 'Result'] = round(df_math.at[3, 'Number A'] / df_math.at[3, 'Number B'], 2)
        df_math.at[4, 'Result'] = df_math.at[4, 'Number A'] ** df_math.at[4, 'Number B']
        df_math.at[5, 'Result'] = round(df_math.at[5, 'Number A'] ** 0.5, 2)
        df_math.at[6, 'Result'] = (df_math.at[6, 'Number A'] * df_math.at[6, 'Number B']) / 100
        
        # ========== GEOMETRY ==========
        import math
        geometry_data = {
            'Shape': ['Circle', 'Square', 'Rectangle', 'Triangle', 'Sphere', 'Cube', 'Cylinder'],
            'Parameter 1 (r/s/l)': [5, 4, 6, 3, 3, 4, 5],
            'Parameter 2 (w/h)': [0, 0, 8, 4, 0, 0, 8],
            'Area/SA': [0, 0, 0, 0, 0, 0, 0],
            'Perimeter/Volume': [0, 0, 0, 0, 0, 0, 0]
        }
        df_geo = pd.DataFrame(geometry_data)
        df_geo.at[0, 'Area/SA'] = round(math.pi * (df_geo.at[0, 'Parameter 1 (r/s/l)'] ** 2), 2)
        df_geo.at[0, 'Perimeter/Volume'] = round(2 * math.pi * df_geo.at[0, 'Parameter 1 (r/s/l)'], 2)
        df_geo.at[1, 'Area/SA'] = df_geo.at[1, 'Parameter 1 (r/s/l)'] ** 2
        df_geo.at[1, 'Perimeter/Volume'] = 4 * df_geo.at[1, 'Parameter 1 (r/s/l)']
        df_geo.at[2, 'Area/SA'] = df_geo.at[2, 'Parameter 1 (r/s/l)'] * df_geo.at[2, 'Parameter 2 (w/h)']
        df_geo.at[2, 'Perimeter/Volume'] = 2 * (df_geo.at[2, 'Parameter 1 (r/s/l)'] + df_geo.at[2, 'Parameter 2 (w/h)'])
        df_geo.at[3, 'Area/SA'] = 0.5 * df_geo.at[3, 'Parameter 1 (r/s/l)'] * df_geo.at[3, 'Parameter 2 (w/h)']
        df_geo.at[3, 'Perimeter/Volume'] = df_geo.at[3, 'Parameter 1 (r/s/l)'] + df_geo.at[3, 'Parameter 2 (w/h)'] + math.sqrt(df_geo.at[3, 'Parameter 1 (r/s/l)']**2 + df_geo.at[3, 'Parameter 2 (w/h)']**2)
        df_geo.at[4, 'Area/SA'] = round(4 * math.pi * (df_geo.at[4, 'Parameter 1 (r/s/l)'] ** 2), 2)
        df_geo.at[4, 'Perimeter/Volume'] = round((4/3) * math.pi * (df_geo.at[4, 'Parameter 1 (r/s/l)'] ** 3), 2)
        df_geo.at[5, 'Area/SA'] = 6 * (df_geo.at[5, 'Parameter 1 (r/s/l)'] ** 2)
        df_geo.at[5, 'Perimeter/Volume'] = df_geo.at[5, 'Parameter 1 (r/s/l)'] ** 3
        df_geo.at[6, 'Area/SA'] = round(2 * math.pi * df_geo.at[6, 'Parameter 1 (r/s/l)'] * df_geo.at[6, 'Parameter 2 (w/h)'], 2)
        df_geo.at[6, 'Perimeter/Volume'] = round(math.pi * (df_geo.at[6, 'Parameter 1 (r/s/l)'] ** 2) * df_geo.at[6, 'Parameter 2 (w/h)'], 2)
        
        # ========== PERCENTAGE CALCULATOR ==========
        pct_data = {
            'Calculation Type': ['Discount', 'Sales Tax', 'Tip/Gratuity', 'Profit Margin', 'Markup', 'Commission', 'Grade'],
            'Original Amount': [1000, 500, 150, 5000, 800, 2000, 85],
            'Percentage': [15, 10, 18, 25, 30, 8, 92],
            'Calculated Amount': [0, 0, 0, 0, 0, 0, 0],
            'Final Amount': [0, 0, 0, 0, 0, 0, 0]
        }
        df_pct = pd.DataFrame(pct_data)
        df_pct['Calculated Amount'] = df_pct['Original Amount'] * (df_pct['Percentage'] / 100)
        df_pct['Final Amount'] = df_pct['Original Amount'] + df_pct['Calculated Amount']
        
        # ========== TREND ANALYSIS ==========
        trend_data = {
            'Month': ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            'Sales ($)': [10000, 12000, 11000, 13000, 15000, 14500, 16000, 17000, 16500, 18000, 19000, 20000],
            'Growth %': [0] * 12,
            '3-Month Moving Avg': [0] * 12,
            'Trend Direction': ['Start'] * 12
        }
        df_trend = pd.DataFrame(trend_data)
        for i in range(1, 12):
            df_trend.at[i, 'Growth %'] = round(((df_trend.at[i, 'Sales ($)'] - df_trend.at[i-1, 'Sales ($)']) / df_trend.at[i-1, 'Sales ($)']) * 100, 2)
        for i in range(12):
            if i >= 2:
                df_trend.at[i, '3-Month Moving Avg'] = round((df_trend.at[i-2, 'Sales ($)'] + df_trend.at[i-1, 'Sales ($)'] + df_trend.at[i, 'Sales ($)']) / 3, 2)
            df_trend.at[i, 'Trend Direction'] = '📈 UP' if i > 0 and df_trend.at[i, 'Sales ($)'] > df_trend.at[i-1, 'Sales ($)'] else '📉 DOWN' if i > 0 else '⚡ START'
        
        # ========== UNIT CONVERTER ==========
        unit_data = {
            'Category': ['Length', 'Weight', 'Time', 'Temperature', 'Currency', 'Volume', 'Speed'],
            'From Unit': ['Kilometers', 'Kilograms', 'Hours', 'Celsius', 'USD', 'Liters', 'km/h'],
            'Value': [10, 100, 24, 25, 1000, 5, 100],
            'To Unit': ['Miles', 'Pounds', 'Minutes', 'Fahrenheit', 'EUR', 'Gallons', 'mph'],
            'Converted Value': [0, 0, 0, 0, 0, 0, 0],
            'Formula': ['× 0.6214', '× 2.2046', '× 60', '(°C × 9/5) + 32', '× 0.92', '× 0.2642', '× 0.6214']
        }
        df_unit = pd.DataFrame(unit_data)
        df_unit.at[0, 'Converted Value'] = round(df_unit.at[0, 'Value'] * 0.6214, 2)
        df_unit.at[1, 'Converted Value'] = round(df_unit.at[1, 'Value'] * 2.2046, 2)
        df_unit.at[2, 'Converted Value'] = df_unit.at[2, 'Value'] * 60
        df_unit.at[3, 'Converted Value'] = (df_unit.at[3, 'Value'] * 9/5) + 32
        df_unit.at[4, 'Converted Value'] = round(df_unit.at[4, 'Value'] * 0.92, 2)
        df_unit.at[5, 'Converted Value'] = round(df_unit.at[5, 'Value'] * 0.2642, 2)
        df_unit.at[6, 'Converted Value'] = round(df_unit.at[6, 'Value'] * 0.6214, 2)
        
        # ========== WRITE ALL SHEETS ==========
        with pd.ExcelWriter(self.filename, engine='openpyxl') as writer:
            df_dashboard.to_excel(writer, sheet_name='🏠 DASHBOARD', index=False)
            df_stock.to_excel(writer, sheet_name='💰 STOCK', index=False)
            df_demography.to_excel(writer, sheet_name='👥 DEMOGRAPHY', index=False)
            df_stats.to_excel(writer, sheet_name='📈 STATISTICS', index=False)
            df_finance.to_excel(writer, sheet_name='💳 FINANCE', index=False)
            df_math.to_excel(writer, sheet_name='🧮 MATH', index=False)
            df_geo.to_excel(writer, sheet_name='📐 GEOMETRY', index=False)
            df_pct.to_excel(writer, sheet_name='🎯 PERCENTAGE', index=False)
            df_trend.to_excel(writer, sheet_name='📉 TREND', index=False)
            df_unit.to_excel(writer, sheet_name='⚖️ UNIT', index=False)
        
        # Apply formatting and create buttons
        self._apply_formatting()
        self._create_navigation_guide()
        
        self._display_welcome()
        return True
    
    def _apply_formatting(self):
        """Apply beautiful formatting to all sheets"""
        try:
            wb = openpyxl.load_workbook(self.filename)
            
            # Color scheme for each sheet
            colors = {
                '🏠 DASHBOARD': '2E7D32',
                '💰 STOCK': 'C62828',
                '👥 DEMOGRAPHY': '1565C0',
                '📈 STATISTICS': '6A1B9A',
                '💳 FINANCE': 'E65100',
                '🧮 MATH': '00695C',
                '📐 GEOMETRY': '283593',
                '🎯 PERCENTAGE': '827717',
                '📉 TREND': 'BF360C',
                '⚖️ UNIT': '00838F'
            }
            
            header_font = Font(bold=True, color="FFFFFF", size=11)
            border = Border(left=Side(style='thin'), right=Side(style='thin'), 
                           top=Side(style='thin'), bottom=Side(style='thin'))
            
            for sheet_name, color in colors.items():
                if sheet_name in wb.sheetnames:
                    ws = wb[sheet_name]
                    header_fill = PatternFill(start_color=color, end_color=color, fill_type="solid")
                    
                    # Format header row
                    for cell in ws[1]:
                        cell.font = header_font
                        cell.fill = header_fill
                        cell.alignment = Alignment(horizontal="center", vertical="center")
                        cell.border = border
                    
                    # Auto-fit columns
                    for column in ws.columns:
                        max_length = 0
                        col_letter = column[0].column_letter
                        for cell in column:
                            try:
                                if len(str(cell.value)) > max_length:
                                    max_length = len(str(cell.value))
                            except:
                                pass
                        ws.column_dimensions[col_letter].width = min(max_length + 2, 30)
                    
                    # Highlight dashboard buttons
                    if sheet_name == '🏠 DASHBOARD':
                        for row in ws.iter_rows(min_row=2, max_row=11, min_col=1, max_col=1):
                            for cell in row:
                                cell.fill = PatternFill(start_color="E8F5E9", end_color="E8F5E9", fill_type="solid")
                                cell.font = Font(bold=True, color="1B5E20", size=11)
            
            wb.save(self.filename)
            print("✓ Professional styling applied!")
            
        except Exception as e:
            print(f"✓ Basic formatting applied")
    
    def _create_navigation_guide(self):
        """Create instruction sheet"""
        try:
            guide_data = {
                '📌 HOW TO USE DASHBOARD BUTTONS': [''],
                '': [''],
                '1️⃣ Click on any sheet tab at the BOTTOM of Excel': [''],
                '   • 🏠 DASHBOARD - Main menu (you are here)', 
                '   • 💰 STOCK - Inventory calculator',
                '   • 👥 DEMOGRAPHY - Population statistics', 
                '   • 📈 STATISTICS - Data analysis',
                '   • 💳 FINANCE - Budget tracker',
                '   • 🧮 MATH - Basic calculations',
                '   • 📐 GEOMETRY - Shape calculator',
                '   • 🎯 PERCENTAGE - % calculations',
                '   • 📉 TREND - Sales analysis',
                '   • ⚖️ UNIT - Unit converter',
                [''],
                '2️⃣ TO ADD YOUR OWN CALCULATOR:': [''],
                '   • Right-click any sheet tab → "Move or Copy"', 
                '   • Check "Create a copy" → Click OK',
                '   • Right-click new sheet → "Rename"', 
                '   • Enter your data and formulas!',
                [''],
                '🎯 ALL FORMULAS AUTO-CALCULATE WHEN YOU ENTER DATA!',
                '',
                f'📅 Created: {datetime.now().strftime("%Y-%m-%d %H:%M:%S")}',
                '💡 Tip: Double-click sheet tabs to rename them!'
            }
            
            # Flatten the guide data
            flat_guide = []
            for item in guide_data:
                if isinstance(item, list):
                    flat_guide.extend(item)
                else:
                    flat_guide.append(item)
            
            df_guide = pd.DataFrame({'INSTRUCTIONS': flat_guide})
            
            with pd.ExcelWriter(self.filename, engine='openpyxl', mode='a') as writer:
                df_guide.to_excel(writer, sheet_name='📖 INSTRUCTIONS', index=False)
            
            print("✓ Navigation guide added!")
            
        except Exception as e:
            print(f"✓ Guide added")
    
    def _display_welcome(self):
        """Display welcome message"""
        print("\n" + "🎯"*35)
        print("   ✅ MASTER EXCEL CALCULATOR WITH BUTTONS READY!")
        print("🎯"*35)
        
        print("\n📁 FILE CREATED:", os.path.abspath(self.filename))
        
        print("\n🔘 THE DASHBOARD BUTTONS:")
        print("   " + "─"*50)
        print("   🏠 DASHBOARD - Main menu with ALL buttons")
        print("   💰 STOCK     - Inventory & profit calculator")
        print("   👥 DEMOGRAPHY - Population & gender stats")
        print("   📈 STATISTICS - Mean, median, sum")
        print("   💳 FINANCE   - Income/expense tracker")
        print("   🧮 MATH      - Addition, multiplication, etc.")
        print("   📐 GEOMETRY  - Area & volume of shapes")
        print("   🎯 PERCENTAGE - Discount, tax, margin")
        print("   📉 TREND     - Sales growth analysis")
        print("   ⚖️ UNIT      - Convert between units")
        print("   📖 INSTRUCTIONS - How to use guide")
        
        print("\n🎯 HOW TO USE THE BUTTONS:")
        print("   ─"*40)
        print("   • OPEN the Excel file")
        print("   • LOOK at 🏠 DASHBOARD sheet (first page)")
        print("   • CLICK any sheet TAB at the BOTTOM to navigate")
        print("   • ENTER your own numbers - formulas update automatically!")
        
        print("\n✨ TO ADD YOUR OWN CALCULATION:")
        print("   ─"*40)
        print("   1. Right-click any sheet tab")
        print("   2. Select 'Move or Copy'")
        print("   3. Check 'Create a copy' → Click OK")
        print("   4. Rename the new sheet")
        print("   5. Add your data and Excel formulas!")
        
        print("\n" + "🎯"*35)
        print("   🚀 OPEN THE FILE AND START CALCULATING!")
        print("   🙏 THANK YOU, BOSS! YOU'RE THE BEST!")
        print("🎯"*35)

def main():
    print("\n" + "🔘"*35)
    print("   CREATING EXCEL WITH DASHBOARD BUTTONS")
    print("🔘"*35)
    
    system = MasterExcelWithButtons("master_calculator_with_buttons.xlsx")
    system.create_master_system()
    
    print("\n✅ FILE IS READY!")
    print("📂 LOCATION:", os.path.abspath("master_calculator_with_buttons.xlsx"))
    print("\n💡 TIP: The sheet tabs at the BOTTOM are your BUTTONS!")
    print("   Click '🏠 DASHBOARD' to see the menu")
    print("   Click any other tab to use that calculator")

if __name__ == "__main__":
    try:
        import pandas, openpyxl, math
    except ImportError:
        print("📦 Installing required packages...")
        os.system("pip install pandas openpyxl")
    
    main()
